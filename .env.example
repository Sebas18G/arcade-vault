# Copiar a `.env` (desarrollo) o cargar en el host (producción).
# Hay dos proyectos de Supabase: ver references/migracion-produccion.md.

# --- Supabase -----------------------------------------------------------------
# Settings -> API del proyecto correspondiente. Cambian entre dev y producción.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para el CLI o psql; la app no la lee. No cargar en el host.
SUPABASE_DB_PASSWORD=

# --- Resend (formulario de contacto de /about) --------------------------------
RESEND_API_KEY=
# El remitente necesita un dominio verificado en Resend. El de pruebas
# (onboarding@resend.dev) solo entrega a tu propia dirección.
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
